    ...n,
    coord: areaCoord(n.area),
    photo: n.name.includes("إبراهيم ماهر") ? BRAND.nursePhotoUrl : `https://ui-avatars.com/api/?name=${encodeURIComponent(n.name)}&background=143B67&color=fff&size=128&bold=true`,
  }));
}

